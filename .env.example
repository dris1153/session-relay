# Copy to `.env` (git-ignored) and fill in. Read at build time by src-tauri/build.rs.
# Both values are public identifiers of YOUR GitHub App (device flow needs no client secret).
# Forks and other users must register their own app.

# GitHub App > General > "Client ID" (starts with Iv23li...)
SR_GITHUB_CLIENT_ID=

# Last segment of the app's public URL: https://github.com/apps/<slug>
SR_GITHUB_APP_SLUG=
